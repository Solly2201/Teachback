# TeachBack environment configuration.
# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# ALL values here default to OFF/empty: a checkout with no .env behaves
# exactly like TeachBack v1 (no LLM anywhere).

# --- experimental generative-probe research layer ---------------------------
# Both flags must be true for generated probes; with either false the
# application makes zero LLM calls.
TEACHBACK_LLM_ENABLED=false
TEACHBACK_GENERATIVE_PROBES=false

# Provider order. The backend decides this; students never see or choose it.
TEACHBACK_LLM_PRIMARY=gemini
TEACHBACK_LLM_FALLBACK=groq

# Gemini (primary). Get a key at https://aistudio.google.com/apikey (free tier).
# Model names change over time (gemini-2.5-flash is already retired for new
# API users) — check the current model list and set it here, never in code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Thinking level for Gemini thinking models. "low" keeps probe generation
# fast (~4s vs ~20s+ at the default level). Leave empty for models that
# reject thinkingConfig.
GEMINI_THINKING_LEVEL=low

# Groq (fallback). Get a key at https://console.groq.com/keys (free tier).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Reliability. max_retries applies only to malformed-output retries on the
# same provider; transient/quota errors fail over immediately (no storms).
# Gemini thinking models show highly variable latency (measured 3-21s per
# probe at thinkingLevel=low), so 30s avoids spurious timeout failovers.
TEACHBACK_LLM_MAX_RETRIES=1
TEACHBACK_LLM_TIMEOUT_SECONDS=30
